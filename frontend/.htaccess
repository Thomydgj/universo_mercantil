Options -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Canonical host and HTTPS: redirect the apex and HTTP variants to www.
RewriteCond %{HTTP_HOST} ^(www\.)?universomercantilsas\.com$ [NC]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^universomercantilsas\.com$ [NC]
RewriteRule ^ https://www.universomercantilsas.com%{REQUEST_URI} [R=301,L,NE]

# Canonicalize extensionless paths (except real directories)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Redirect legacy index URLs to canonical root
RewriteCond %{THE_REQUEST} \s/+index(?:\.html)?(?:[\s?]|$) [NC]
RewriteRule ^index(?:\.html)?$ / [R=301,L]

# Redirect explicit .html requests to clean paths
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html(?:[\s?]|$) [NC]
RewriteRule ^(.+?)\.html$ /$1 [R=301,L]

# Serve extensionless routes from matching .html files
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>
