# Wompi
WOMPI_PUBLIC_KEY=pub_test_your_public_key
WOMPI_PRIVATE_KEY=prv_test_your_private_key
WOMPI_INTEGRITY_SECRET=test_integrity_your_secret
WOMPI_WEBHOOK_SECRET=test_webhook_secret
WOMPI_URL=https://sandbox.wompi.co/v1

# Siigo
SIIGO_API_BASE_URL=https://api.siigo.com
SIIGO_PRODUCTS_PATH=/v1/products
SIIGO_USERNAME=your_siigo_user@example.com
SIIGO_ACCESS_KEY=your_siigo_access_key
SIIGO_PARTNER_ID=your_siigo_partner_id
SIIGO_REQUEST_TIMEOUT_SECONDS=20
SIIGO_TOKEN_SAFETY_SECONDS=60
SIIGO_CATALOG_CACHE_TTL_SECONDS=300
SIIGO_HIDE_ITEMS_WITHOUT_IMAGE_DEFAULT=true
SIIGO_IMAGE_MANIFEST_PATH=../frontend/scripts/siigo_imagenes.json
SIIGO_SYNC_INVENTORY_ON_APPROVED=true
SIIGO_INVENTORY_UPDATE_METHOD=PATCH
SIIGO_INVENTORY_UPDATE_PATH_TEMPLATE=/v1/products/{product_id}

# Public backend URL used in Wompi redirect
BACKEND_BASE_URL=http://localhost:8000

# Public frontend URL used by checkout confirmation links
FRONTEND_BASE_URL=https://www.tudominio.com

# Optional: sales WhatsApp used in post-payment confirmation page
SALES_WHATSAPP_NUMBER=573001234567

# PostgreSQL (when configured, backend stores orders/events in database)
# Example: postgresql+psycopg://user:password@localhost:5432/universo_mercantil
DATABASE_URL=

# CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Flask runtime
FLASK_DEBUG=false
PORT=8000
LOG_LEVEL=INFO

# Optional API hardening
BACKEND_API_KEY=
BACKEND_API_KEYS=
MAX_REQUEST_BODY_BYTES=262144
MIN_ORDER_AMOUNT_IN_CENTS=50000
MAX_ORDER_AMOUNT_IN_CENTS=10000000000
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=50
RATE_LIMIT_CATALOG_WINDOW_SECONDS=60
RATE_LIMIT_CATALOG_MAX_REQUESTS=50
RATE_LIMIT_CHECKOUT_WINDOW_SECONDS=60
RATE_LIMIT_CHECKOUT_MAX_REQUESTS=20
RATE_LIMIT_DIRECT_PAYMENT_WINDOW_SECONDS=60
RATE_LIMIT_DIRECT_PAYMENT_MAX_REQUESTS=20
RATE_LIMIT_RESULT_WINDOW_SECONDS=60
RATE_LIMIT_RESULT_MAX_REQUESTS=60
RATE_LIMIT_WEBHOOK_WINDOW_SECONDS=60
RATE_LIMIT_WEBHOOK_MAX_REQUESTS=80
IDEMPOTENCY_WINDOW_SECONDS=900
IDEMPOTENCY_KEY_MIN_LENGTH=16
IDEMPOTENCY_KEY_MAX_LENGTH=128
MAX_IDEMPOTENCY_CACHE_ENTRIES=5000
IDEMPOTENCY_ENFORCED_SCOPES=checkout,direct-payment

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=your_email@example.com
COMPANY_NAME=Universo Mercantil
EMAIL_LOGO_URL=assets/logo.webp
SUPPORT_EMAIL=soporte@universomercantil.com

# Billing notification targets
FACTURACION_EMAIL_TO=billing@example.com
FACTURACION_EMAIL_CC=
